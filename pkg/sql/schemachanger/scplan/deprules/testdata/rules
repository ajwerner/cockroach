rules
----
- name: database dependencies
  from: parent-node
  to: other-node
  query:
    - $direction = DROP
    - $status IN [DELETE_ONLY, DELETE_AND_WRITE_ONLY]
    - $parent[Type] = '*scpb.Database'
    - $other[Type] IN ['*scpb.Type', '*scpb.Table', '*scpb.View', '*scpb.Sequence', '*scpb.Schema']
    - depends-on(*scpb.Database, scpb.Element)($parent, $other)
    - $parent-target[Direction] = direction
    - $other-target[Direction] = direction
    - $parent-node[Status] = status
    - $other-node[Status] = status
    - $parent-target[Type] = '*scpb.Target'
    - $parent-target[Element] = parent
    - $parent-node[Type] = '*scpb.Node'
    - $parent-node[Target] = parent-target
    - $other-target[Type] = '*scpb.Target'
    - $other-target[Element] = other
    - $other-node[Type] = '*scpb.Node'
    - $other-node[Target] = other-target
- name: schema dependencies
  from: parent-node
  to: other-node
  query:
    - $direction = DROP
    - $status IN [DELETE_ONLY, DELETE_AND_WRITE_ONLY]
    - $parent[Type] = '*scpb.Schema'
    - $other[Type] IN ['*scpb.Type', '*scpb.Table', '*scpb.View', '*scpb.Sequence']
    - schema-depends-on(*scpb.Schema, scpb.Element)($parent, $other)
    - $parent-target[Direction] = direction
    - $other-target[Direction] = direction
    - $parent-node[Status] = status
    - $other-node[Status] = status
    - $parent-target[Type] = '*scpb.Target'
    - $parent-target[Element] = parent
    - $parent-node[Type] = '*scpb.Node'
    - $parent-node[Target] = parent-target
    - $other-target[Type] = '*scpb.Target'
    - $other-target[Element] = other
    - $other-node[Type] = '*scpb.Node'
    - $other-node[Target] = other-target
- name: sequence owned by being dropped relies on sequence entering delete only
  from: owned-by-node
  to: seq-node
  query:
    - $direction = DROP
    - $owned-by[Type] = '*scpb.SequenceOwnedBy'
    - $seq[Type] = '*scpb.Sequence'
    - $owned-by[DescID] = id
    - $seq[DescID] = id
    - $owned-by-target[Direction] = direction
    - $seq-target[Direction] = direction
    - $seq-node[Status] = ABSENT
    - $owned-by-node[Status] = DELETE_ONLY
    - $owned-by-target[Type] = '*scpb.Target'
    - $owned-by-target[Element] = owned-by
    - $owned-by-node[Type] = '*scpb.Node'
    - $owned-by-node[Target] = owned-by-target
    - $seq-target[Type] = '*scpb.Target'
    - $seq-target[Element] = seq
    - $seq-node[Type] = '*scpb.Node'
    - $seq-node[Target] = seq-target
- name: type reference something
  from: type-node
  to: type-ref-node
  query:
    - $direction = DROP
    - $type[Type] = '*scpb.Type'
    - $type-ref[Type] = '*scpb.TypeReference'
    - $type[DescID] = id
    - $type-ref[ReferencedDescID] = id
    - $type-target[Direction] = direction
    - $type-ref-target[Direction] = direction
    - $type-node[Status] = PUBLIC
    - $type-ref-node[Status] = DELETE_ONLY
    - $type-target[Type] = '*scpb.Target'
    - $type-target[Element] = type
    - $type-node[Type] = '*scpb.Node'
    - $type-node[Target] = type-target
    - $type-ref-target[Type] = '*scpb.Target'
    - $type-ref-target[Element] = type-ref
    - $type-ref-node[Type] = '*scpb.Node'
    - $type-ref-node[Target] = type-ref-target
- name: view depends on view
  from: from-node
  to: to-node
  query:
    - $direction = DROP
    - $status = ABSENT
    - $from[Type] = '*scpb.View'
    - $to[Type] = '*scpb.View'
    - depended-on-by(*scpb.View, *scpb.View)($from, $to)
    - $from-target[Direction] = direction
    - $to-target[Direction] = direction
    - $from-node[Status] = status
    - $to-node[Status] = status
    - $from-target[Type] = '*scpb.Target'
    - $from-target[Element] = from
    - $from-node[Type] = '*scpb.Node'
    - $from-node[Target] = from-target
    - $to-target[Type] = '*scpb.Target'
    - $to-target[Element] = to
    - $to-node[Type] = '*scpb.Node'
    - $to-node[Target] = to-target
- name: view depends on type
  from: from-node
  to: to-node
  query:
    - $direction = DROP
    - $status = ABSENT
    - $from[Type] = '*scpb.View'
    - $to[Type] = '*scpb.TypeReference'
    - $from[DescID] = id
    - $to[DescID] = id
    - $from-target[Direction] = direction
    - $to-target[Direction] = direction
    - $from-node[Status] = status
    - $to-node[Status] = status
    - $from-target[Type] = '*scpb.Target'
    - $from-target[Element] = from
    - $from-node[Type] = '*scpb.Node'
    - $from-node[Target] = from-target
    - $to-target[Type] = '*scpb.Target'
    - $to-target[Element] = to
    - $to-node[Type] = '*scpb.Node'
    - $to-node[Target] = to-target
- name: column depends on indexes
  from: column-node
  to: index-node
  query:
    - $status IN [DELETE_AND_WRITE_ONLY, PUBLIC]
    - $direction = ADD
    - $column[Type] = '*scpb.Column'
    - $index[Type] IN ['*scpb.PrimaryIndex', '*scpb.SecondaryIndex']
    - $column[DescID] = id
    - $index[DescID] = id
    - column-in-index(*scpb.Column, scpb.Entity)($column, $index)
    - $column-target[Direction] = direction
    - $index-target[Direction] = direction
    - $column-node[Status] = status
    - $index-node[Status] = status
    - $column-target[Type] = '*scpb.Target'
    - $column-target[Element] = column
    - $column-node[Type] = '*scpb.Node'
    - $column-node[Target] = column-target
    - $index-target[Type] = '*scpb.Target'
    - $index-target[Element] = index
    - $index-node[Type] = '*scpb.Node'
    - $index-node[Target] = index-target
- name: primary index add depends on drop
  from: add-node
  to: drop-node
  query:
    - $add[Type] = '*scpb.PrimaryIndex'
    - $drop[Type] = '*scpb.PrimaryIndex'
    - $add[DescID] = id
    - $drop[DescID] = id
    - reference-each-other(*scpb.PrimaryIndex, *scpb.PrimaryIndex)($add, $drop)
    - $add-target[Direction] = ADD
    - $drop-target[Direction] = DROP
    - $add-node[Status] = PUBLIC
    - $drop-node[Status] = DELETE_AND_WRITE_ONLY
    - $add-target[Type] = '*scpb.Target'
    - $add-target[Element] = add
    - $add-node[Type] = '*scpb.Node'
    - $add-node[Target] = add-target
    - $drop-target[Type] = '*scpb.Target'
    - $drop-target[Element] = drop
    - $drop-node[Type] = '*scpb.Node'
    - $drop-node[Target] = drop-target
- name: primary index drop depends on add
  from: drop-node
  to: add-node
  query:
    - $add[Type] = '*scpb.PrimaryIndex'
    - $drop[Type] = '*scpb.PrimaryIndex'
    - $add[DescID] = id
    - $drop[DescID] = id
    - reference-each-other(*scpb.PrimaryIndex, *scpb.PrimaryIndex)($add, $drop)
    - $add-target[Direction] = ADD
    - $drop-target[Direction] = DROP
    - $add-node[Status] = PUBLIC
    - $drop-node[Status] = DELETE_AND_WRITE_ONLY
    - $add-target[Type] = '*scpb.Target'
    - $add-target[Element] = add
    - $add-node[Type] = '*scpb.Node'
    - $add-node[Target] = add-target
    - $drop-target[Type] = '*scpb.Target'
    - $drop-target[Element] = drop
    - $drop-node[Type] = '*scpb.Node'
    - $drop-node[Target] = drop-target
