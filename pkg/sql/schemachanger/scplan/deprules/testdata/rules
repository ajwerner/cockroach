rules
----
- name: database dependencies
  from: parent-node
  to: other-node
  query:
    - [=, $direction, DROP]
    - [=, $status, [DELETE_ONLY, DELETE_AND_WRITE_ONLY]]
    - [Type, $parent, '*scpb.Database']
    - [Type, $other, ['*scpb.Type', '*scpb.Table', '*scpb.View', '*scpb.Sequence', '*scpb.Schema']]
    - [[func, depends-on, ['*scpb.Database', scpb.Element]], $parent, $other]
    - [Direction, $parent-target, $direction]
    - [Direction, $other-target, $direction]
    - [Status, $parent-node, $status]
    - [Status, $other-node, $status]
    - [Type, $parent-target, '*scpb.Target']
    - [Element, $parent-target, $parent]
    - [Type, $parent-node, '*scpb.Node']
    - [Target, $parent-node, $parent-target]
    - [Type, $other-target, '*scpb.Target']
    - [Element, $other-target, $other]
    - [Type, $other-node, '*scpb.Node']
    - [Target, $other-node, $other-target]
- name: schema dependencies
  from: parent-node
  to: other-node
  query:
    - [=, $direction, DROP]
    - [=, $status, [DELETE_ONLY, DELETE_AND_WRITE_ONLY]]
    - [Type, $parent, '*scpb.Schema']
    - [Type, $other, ['*scpb.Type', '*scpb.Table', '*scpb.View', '*scpb.Sequence']]
    - [[func, schema-depends-on, ['*scpb.Schema', scpb.Element]], $parent, $other]
    - [Direction, $parent-target, $direction]
    - [Direction, $other-target, $direction]
    - [Status, $parent-node, $status]
    - [Status, $other-node, $status]
    - [Type, $parent-target, '*scpb.Target']
    - [Element, $parent-target, $parent]
    - [Type, $parent-node, '*scpb.Node']
    - [Target, $parent-node, $parent-target]
    - [Type, $other-target, '*scpb.Target']
    - [Element, $other-target, $other]
    - [Type, $other-node, '*scpb.Node']
    - [Target, $other-node, $other-target]
- name: sequence owned by being dropped relies on sequence entering delete only
  from: owned-by-node
  to: seq-node
  query:
    - [=, $direction, DROP]
    - [Type, $owned-by, '*scpb.SequenceOwnedBy']
    - [Type, $seq, '*scpb.Sequence']
    - [DescID, $owned-by, $id]
    - [DescID, $seq, $id]
    - [Direction, $owned-by-target, $direction]
    - [Direction, $seq-target, $direction]
    - [Status, $seq-node, ABSENT]
    - [Status, $owned-by-node, DELETE_ONLY]
    - [Type, $owned-by-target, '*scpb.Target']
    - [Element, $owned-by-target, $owned-by]
    - [Type, $owned-by-node, '*scpb.Node']
    - [Target, $owned-by-node, $owned-by-target]
    - [Type, $seq-target, '*scpb.Target']
    - [Element, $seq-target, $seq]
    - [Type, $seq-node, '*scpb.Node']
    - [Target, $seq-node, $seq-target]
- name: type reference something
  from: type-node
  to: type-ref-node
  query:
    - [=, $direction, DROP]
    - [Type, $type, '*scpb.Type']
    - [Type, $type-ref, '*scpb.TypeReference']
    - [DescID, $type, $id]
    - [ReferencedDescID, $type-ref, $id]
    - [Direction, $type-target, $direction]
    - [Direction, $type-ref-target, $direction]
    - [Status, $type-node, PUBLIC]
    - [Status, $type-ref-node, DELETE_ONLY]
    - [Type, $type-target, '*scpb.Target']
    - [Element, $type-target, $type]
    - [Type, $type-node, '*scpb.Node']
    - [Target, $type-node, $type-target]
    - [Type, $type-ref-target, '*scpb.Target']
    - [Element, $type-ref-target, $type-ref]
    - [Type, $type-ref-node, '*scpb.Node']
    - [Target, $type-ref-node, $type-ref-target]
- name: view depends on view
  from: from-node
  to: to-node
  query:
    - [=, $direction, DROP]
    - [=, $status, ABSENT]
    - [Type, $from, '*scpb.View']
    - [Type, $to, '*scpb.View']
    - [[func, depended-on-by, ['*scpb.View', '*scpb.View']], $from, $to]
    - [Direction, $from-target, $direction]
    - [Direction, $to-target, $direction]
    - [Status, $from-node, $status]
    - [Status, $to-node, $status]
    - [Type, $from-target, '*scpb.Target']
    - [Element, $from-target, $from]
    - [Type, $from-node, '*scpb.Node']
    - [Target, $from-node, $from-target]
    - [Type, $to-target, '*scpb.Target']
    - [Element, $to-target, $to]
    - [Type, $to-node, '*scpb.Node']
    - [Target, $to-node, $to-target]
- name: view depends on type
  from: from-node
  to: to-node
  query:
    - [=, $direction, DROP]
    - [=, $status, ABSENT]
    - [Type, $from, '*scpb.View']
    - [Type, $to, '*scpb.TypeReference']
    - [DescID, $from, $id]
    - [DescID, $to, $id]
    - [Direction, $from-target, $direction]
    - [Direction, $to-target, $direction]
    - [Status, $from-node, $status]
    - [Status, $to-node, $status]
    - [Type, $from-target, '*scpb.Target']
    - [Element, $from-target, $from]
    - [Type, $from-node, '*scpb.Node']
    - [Target, $from-node, $from-target]
    - [Type, $to-target, '*scpb.Target']
    - [Element, $to-target, $to]
    - [Type, $to-node, '*scpb.Node']
    - [Target, $to-node, $to-target]
- name: column depends on indexes
  from: column-node
  to: index-node
  query:
    - [=, $status, [DELETE_AND_WRITE_ONLY, PUBLIC]]
    - [=, $direction, ADD]
    - [Type, $column, '*scpb.Column']
    - [Type, $index, ['*scpb.PrimaryIndex', '*scpb.SecondaryIndex']]
    - [DescID, $column, $id]
    - [DescID, $index, $id]
    - [[func, column-in-index, ['*scpb.Column', scpb.Entity]], $column, $index]
    - [Direction, $column-target, $direction]
    - [Direction, $index-target, $direction]
    - [Status, $column-node, $status]
    - [Status, $index-node, $status]
    - [Type, $column-target, '*scpb.Target']
    - [Element, $column-target, $column]
    - [Type, $column-node, '*scpb.Node']
    - [Target, $column-node, $column-target]
    - [Type, $index-target, '*scpb.Target']
    - [Element, $index-target, $index]
    - [Type, $index-node, '*scpb.Node']
    - [Target, $index-node, $index-target]
- name: primary index add depends on drop
  from: add-node
  to: drop-node
  query:
    - [Type, $add, '*scpb.PrimaryIndex']
    - [Type, $drop, '*scpb.PrimaryIndex']
    - [DescID, $add, $id]
    - [DescID, $drop, $id]
    - [[func, reference-each-other, ['*scpb.PrimaryIndex', '*scpb.PrimaryIndex']], $add, $drop]
    - [Direction, $add-target, ADD]
    - [Direction, $drop-target, DROP]
    - [Status, $add-node, PUBLIC]
    - [Status, $drop-node, DELETE_AND_WRITE_ONLY]
    - [Type, $add-target, '*scpb.Target']
    - [Element, $add-target, $add]
    - [Type, $add-node, '*scpb.Node']
    - [Target, $add-node, $add-target]
    - [Type, $drop-target, '*scpb.Target']
    - [Element, $drop-target, $drop]
    - [Type, $drop-node, '*scpb.Node']
    - [Target, $drop-node, $drop-target]
- name: primary index drop depends on add
  from: drop-node
  to: add-node
  query:
    - [Type, $add, '*scpb.PrimaryIndex']
    - [Type, $drop, '*scpb.PrimaryIndex']
    - [DescID, $add, $id]
    - [DescID, $drop, $id]
    - [[func, reference-each-other, ['*scpb.PrimaryIndex', '*scpb.PrimaryIndex']], $add, $drop]
    - [Direction, $add-target, ADD]
    - [Direction, $drop-target, DROP]
    - [Status, $add-node, PUBLIC]
    - [Status, $drop-node, DELETE_AND_WRITE_ONLY]
    - [Type, $add-target, '*scpb.Target']
    - [Element, $add-target, $add]
    - [Type, $add-node, '*scpb.Node']
    - [Target, $add-node, $add-target]
    - [Type, $drop-target, '*scpb.Target']
    - [Element, $drop-target, $drop]
    - [Type, $drop-node, '*scpb.Node']
    - [Target, $drop-node, $drop-target]
